# Spotify Developer credentials (doc 02)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Per-env GCP projects (created by bootstrap.sh — replace 260529 with your suffix)
GCP_PROJECT_DEV=spotify-pipeline-dev-260529
GCP_PROJECT_STAGING=spotify-pipeline-stg-260529
GCP_PROJECT_PROD=spotify-pipeline-prod-260529

# Default local dbt target
DBT_TARGET=dev

# Market for popularity ranking (Spotify)
MARKET=US
