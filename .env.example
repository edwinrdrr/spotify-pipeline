# Spotify Developer credentials (from docs/setup/02-spotify-app.md)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Market for popularity ranking (ISO-3166 country code). Optional, default US.
MARKET=US

# GCP target (from docs/setup/03-gcp-project.md)
# Replace 260528 with the date suffix you chose when provisioning your project.
GCP_PROJECT=spotify-pipeline-260528

# Optional overrides — defaults are derived from GCP_PROJECT.
# GCS_BUCKET=spotify-pipeline-260528-spotify-raw    # default: ${GCP_PROJECT}-spotify-raw
# BQ_DATASET=spotify_raw                            # default
# BQ_TABLE=top_tracks                               # default
